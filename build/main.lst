   1:Source/main.c **** //
   2:Source/main.c **** // main.c – Playdate C extension: thin Lua bindings over Source/solver.h.
   3:Source/main.c **** //
   4:Source/main.c **** // Lua surface:
   5:Source/main.c **** //   dotsai.solve_reset()            clear the endgame memo (once per AI move)
   6:Source/main.c **** //   dotsai.solve(chains, loops)     endgame value (byte-string component lens)
   7:Source/main.c **** //   dotsai.cold_init(dots, be, eb)  send static board topology once per game
   8:Source/main.c **** //   dotsai.cold(filled, excluded)   cold-component decomposition for a position
   9:Source/main.c **** //   dotsai.exact_begin(freeEdges)   start an exact remaining-edge search
  10:Source/main.c **** //   dotsai.exact_step()             advance one batch; nil until complete
  11:Source/main.c **** //
  12:Source/main.c **** // All algorithmic logic lives in solver.h (pure C, no Playdate deps) so the
  13:Source/main.c **** // exact same code is exercised by the build-time parity test. This file only
  14:Source/main.c **** // marshals data across the Lua/C boundary.
  15:Source/main.c **** //
  16:Source/main.c **** 
  17:Source/main.c **** #include <stdint.h>
  18:Source/main.c **** #include <string.h>
  19:Source/main.c **** 
  20:Source/main.c **** #include "pd_api.h"
  21:Source/main.c **** #include "solver.h"
  22:Source/main.c **** 
  23:Source/main.c **** static PlaydateAPI* pd = NULL;
  24:Source/main.c **** 
