  98:Source/main.c **** 
  99:Source/main.c **** // dotsai.cold(filledBytes, excludedBytes) -> packed component bytes
 100:Source/main.c **** //   filledBytes  : numEdges bytes, 1 if that edge id is filled
 101:Source/main.c **** //   excludedBytes: numBoxes bytes (or empty), 1 if that box is pre-seen (hot)
 102:Source/main.c **** // Return encoding: [numComps] then per comp
 103:Source/main.c **** //   [len][isLoop][edge][nEntries] [entry...]
 104:Source/main.c **** static int lua_cold(lua_State* L) {
 105:Source/main.c ****     (void)L;
 106:Source/main.c ****     if (!s_topo_ready) { pd->lua->pushNil(); return 1; }
 107:Source/main.c **** 
 108:Source/main.c ****     size_t fLen = 0, xLen = 0;
 109:Source/main.c ****     const char* filled   = pd->lua->getArgBytes(1, &fLen);
 110:Source/main.c ****     const char* excluded = pd->lua->getArgBytes(2, &xLen);
 111:Source/main.c ****     if (!filled || fLen < (size_t)s_topo.numEdges) { pd->lua->pushNil(); return 1; }
 112:Source/main.c **** 
 113:Source/main.c ****     // 1-based filled/excluded scratch (index 0 unused, matches topology).
 114:Source/main.c ****     static uint8_t fbuf[DOTSAI_MAX_EDGES + 1];
 115:Source/main.c ****     static uint8_t xbuf[DOTSAI_MAX_BOXES + 1];
 116:Source/main.c ****     fbuf[0] = 0;
 117:Source/main.c ****     for (int e = 1; e <= s_topo.numEdges; e++) fbuf[e] = (uint8_t)filled[e - 1];
 118:Source/main.c ****     uint8_t* xptr = NULL;
 119:Source/main.c ****     if (excluded && xLen >= (size_t)s_topo.numBoxes) {
 120:Source/main.c ****         xbuf[0] = 0;
 121:Source/main.c ****         for (int b = 1; b <= s_topo.numBoxes; b++) xbuf[b] = (uint8_t)excluded[b - 1];
 122:Source/main.c ****         xptr = xbuf;
 123:Source/main.c ****     }
 124:Source/main.c **** 
 125:Source/main.c ****     static ColdComp comps[DOTSAI_MAX_BOXES];
 126:Source/main.c ****     int n = cold_decompose(&s_topo, fbuf, xptr, comps);
 127:Source/main.c **** 
 128:Source/main.c ****     // Serialize.
 129:Source/main.c ****     static uint8_t obuf[1 + DOTSAI_MAX_BOXES * 4 + DOTSAI_MAX_EDGES];
 130:Source/main.c ****     int o = 0;
 131:Source/main.c ****     obuf[o++] = (uint8_t)n;
 132:Source/main.c ****     for (int i = 0; i < n; i++) {
 133:Source/main.c ****         ColdComp* c = &comps[i];
 134:Source/main.c ****         obuf[o++] = (uint8_t)c->len;
 135:Source/main.c ****         obuf[o++] = (uint8_t)c->isLoop;
 136:Source/main.c ****         obuf[o++] = (uint8_t)c->edge;
 137:Source/main.c ****         obuf[o++] = (uint8_t)c->nEntries;
 138:Source/main.c ****         for (int k = 0; k < c->nEntries; k++) obuf[o++] = c->entry[k];
 139:Source/main.c ****     }
 140:Source/main.c ****     pd->lua->pushBytes((const char*)obuf, (size_t)o);
ARM GAS  /var/folders/f4/l09z6jwn7f19llqrrwpfcg0w0000gp/T//ccKvzOQE.s 			page 36


 141:Source/main.c ****     return 1;
 142:Source/main.c **** }
 143:Source/main.c **** 
 144:Source/main.c **** static int lua_exact_begin(lua_State* L) {
 145:Source/main.c ****     (void)L;
 146:Source/main.c ****     size_t count = 0;
 147:Source/main.c ****     const char* edges = pd->lua->getArgBytes(1, &count);
 148:Source/main.c ****     s_exact.next = s_exact.full = 0;
 149:Source/main.c ****     s_exact.bestEdge = 0;
 150:Source/main.c ****     int ok = s_topo_ready && count <= DOTSAI_EXACT_MAX_EDGES
 151:Source/main.c ****         && edge_search_begin(&s_exact, &s_topo, (const uint8_t*)edges, (int)count);
 152:Source/main.c ****     pd->lua->pushBool(ok);
 153:Source/main.c ****     return 1;
 154:Source/main.c **** }
 155:Source/main.c **** 
 156:Source/main.c **** static int lua_exact_step(lua_State* L) {
