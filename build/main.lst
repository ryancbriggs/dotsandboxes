 139:Source/solver.h **** 
 140:Source/solver.h **** // ─── Cold-component decomposition ───────────────────
 141:Source/solver.h **** //
 142:Source/solver.h **** // Mirrors Components.collectCold() in ai.lua exactly, including traversal
 143:Source/solver.h **** // order (boxes ascending; each box's 4 edges in stored top,right,bottom,left
 144:Source/solver.h **** // order; depth-first recursion into the first qualifying 2-filled neighbour).
 145:Source/solver.h **** // That order determines comp.edge / entryEdges, so it must not drift.
 146:Source/solver.h **** //
 147:Source/solver.h **** // Topology (1-based ids, matching board.lua):
 148:Source/solver.h **** //   numBoxes, numEdges
 149:Source/solver.h **** //   boxEdges : numBoxes*4   edge id per (box,slot), slots 0..3
 150:Source/solver.h **** //   edgeBoxes: numEdges*2   box ids adjacent to an edge (0 = none)
 151:Source/solver.h **** // Per-call:
 152:Source/solver.h **** //   filled   : numEdges     1 if that edge id is filled
 153:Source/solver.h **** //   excluded : numBoxes     1 if that box id is pre-seeded as seen (hot)
 154:Source/solver.h **** //
 155:Source/solver.h **** // Output: comps[] each with len, isLoop, edge, nEntries, entry[].
 156:Source/solver.h **** 
 157:Source/solver.h **** #define DOTSAI_MAX_BOXES 49     // (8-1)^2
 158:Source/solver.h **** #define DOTSAI_MAX_EDGES 112    // 8*7*2
 159:Source/solver.h **** 
 160:Source/solver.h **** typedef struct {
 161:Source/solver.h ****     int     len;
 162:Source/solver.h ****     int     isLoop;             // 1 = no entry edges
 163:Source/solver.h ****     int     edge;               // entry[0] for chains, firstEdge for loops
 164:Source/solver.h ****     int     nEntries;
 165:Source/solver.h ****     uint8_t entry[DOTSAI_MAX_EDGES];
 166:Source/solver.h **** } ColdComp;
 167:Source/solver.h **** 
ARM GAS  /var/folders/f4/l09z6jwn7f19llqrrwpfcg0w0000gp/T//ccKvzOQE.s 			page 37


 168:Source/solver.h **** typedef struct {
 169:Source/solver.h ****     int        numBoxes;
 170:Source/solver.h ****     int        numEdges;
 171:Source/solver.h ****     uint8_t    boxEdges[DOTSAI_MAX_BOXES + 1][4];   // 1-based box ids
 172:Source/solver.h ****     uint8_t    edgeBoxes[DOTSAI_MAX_EDGES + 1][2];  // 1-based edge ids; 0=none
 173:Source/solver.h ****     // per-call scratch
 174:Source/solver.h ****     const uint8_t* filled;
 175:Source/solver.h ****     uint8_t        seen[DOTSAI_MAX_BOXES + 1];
 176:Source/solver.h **** } ColdTopo;
 177:Source/solver.h **** 
 178:Source/solver.h **** static int cold_fillcount(const ColdTopo* t, int box) {
 179:Source/solver.h ****     int n = 0;
 180:Source/solver.h ****     for (int k = 0; k < 4; k++) {
 181:Source/solver.h ****         int e = t->boxEdges[box][k];
 182:Source/solver.h ****         if (e && t->filled[e]) n++;
 183:Source/solver.h ****     }
 184:Source/solver.h ****     return n;
 185:Source/solver.h **** }
 186:Source/solver.h **** 
 187:Source/solver.h **** // Depth-first walk identical to the Lua `dfs` closure.
 188:Source/solver.h **** static void cold_dfs(ColdTopo* t, int box, ColdComp* c, int* firstEdge) {
 189:Source/solver.h ****     t->seen[box] = 1;
 190:Source/solver.h ****     c->len += 1;
 191:Source/solver.h ****     for (int k = 0; k < 4; k++) {
 192:Source/solver.h ****         int e = t->boxEdges[box][k];
 193:Source/solver.h ****         if (e == 0 || t->filled[e]) continue;       // only unfilled edges
 194:Source/solver.h ****         if (*firstEdge == 0) *firstEdge = e;         // first unfilled in comp
 195:Source/solver.h **** 
 196:Source/solver.h ****         int b1 = t->edgeBoxes[e][0], b2 = t->edgeBoxes[e][1];
 197:Source/solver.h ****         int neighbor = 0;
 198:Source/solver.h ****         if (b1 && b2) neighbor = (b1 == box) ? b2 : b1;  // only true 2-box edges
 199:Source/solver.h **** 
 200:Source/solver.h ****         if (neighbor && cold_fillcount(t, neighbor) == 2) {
 201:Source/solver.h ****             if (!t->seen[neighbor]) cold_dfs(t, neighbor, c, firstEdge);
 202:Source/solver.h ****         } else {
 203:Source/solver.h ****             c->entry[c->nEntries++] = (uint8_t)e;
 204:Source/solver.h ****         }
 205:Source/solver.h ****     }
 206:Source/solver.h **** }
 207:Source/solver.h **** 
 208:Source/solver.h **** // Returns the number of components written into `out`.
 209:Source/solver.h **** static int cold_decompose(ColdTopo* t, const uint8_t* filled,
 210:Source/solver.h ****                           const uint8_t* excluded, ColdComp* out) {
 211:Source/solver.h ****     t->filled = filled;
 212:Source/solver.h ****     memset(t->seen, 0, sizeof(t->seen));
 213:Source/solver.h ****     if (excluded) {
 214:Source/solver.h ****         for (int b = 1; b <= t->numBoxes; b++)
 215:Source/solver.h ****             if (excluded[b]) t->seen[b] = 1;
 216:Source/solver.h ****     }
 217:Source/solver.h **** 
 218:Source/solver.h ****     int n = 0;
 219:Source/solver.h ****     for (int box = 1; box <= t->numBoxes; box++) {
 220:Source/solver.h ****         if (t->seen[box]) continue;
 221:Source/solver.h ****         if (cold_fillcount(t, box) != 2) continue;
 222:Source/solver.h **** 
 223:Source/solver.h ****         ColdComp* c = &out[n];
 224:Source/solver.h ****         c->len = 0; c->isLoop = 0; c->edge = 0; c->nEntries = 0;
ARM GAS  /var/folders/f4/l09z6jwn7f19llqrrwpfcg0w0000gp/T//ccKvzOQE.s 			page 38


 225:Source/solver.h ****         int firstEdge = 0;
 226:Source/solver.h ****         cold_dfs(t, box, c, &firstEdge);
 227:Source/solver.h **** 
 228:Source/solver.h ****         c->isLoop = (c->nEntries == 0);
 229:Source/solver.h ****         c->edge   = c->isLoop ? firstEdge : c->entry[0];
 230:Source/solver.h ****         n++;
 231:Source/solver.h ****     }
 232:Source/solver.h ****     return n;
 233:Source/solver.h **** }
 234:Source/solver.h **** 
 235:Source/solver.h **** // ─── Exact remaining-edge search ───────────────────�
 236:Source/solver.h **** // Every child removes a bit, so increasing mask order visits children first.
 237:Source/solver.h **** // Values are future box margins for the player to move; captures keep the
 238:Source/solver.h **** // turn. Scores fit in int8_t (at most 49 boxes), using 256 KiB at 18 free edges.
 239:Source/solver.h **** // The caller owns the workspace and advances it in small, interruptible batches.
 240:Source/solver.h **** #define DOTSAI_EXACT_MAX_EDGES 18
 241:Source/solver.h **** 
 242:Source/solver.h **** typedef struct {
 243:Source/solver.h ****     int8_t values[1u << DOTSAI_EXACT_MAX_EDGES];
 244:Source/solver.h ****     uint32_t masks[DOTSAI_EXACT_MAX_EDGES][2];
 245:Source/solver.h ****     uint8_t edges[DOTSAI_EXACT_MAX_EDGES];
 246:Source/solver.h ****     uint32_t next, full;
 247:Source/solver.h ****     int bestEdge;
 248:Source/solver.h **** } EdgeSearch;
 249:Source/solver.h **** 
 250:Source/solver.h **** static int edge_search_begin(EdgeSearch* s, const ColdTopo* t,
 251:Source/solver.h ****                              const uint8_t* freeEdges, int count) {
 252:Source/solver.h ****     s->next = s->full = 0;
 253:Source/solver.h ****     s->bestEdge = 0;
