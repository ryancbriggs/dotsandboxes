  25:Source/main.c **** // Resident board topology, set by dotsai.cold_init at game start.
  26:Source/main.c **** static ColdTopo s_topo;
  27:Source/main.c **** static int      s_topo_ready = 0;
  28:Source/main.c **** static EdgeSearch s_exact;
  29:Source/main.c **** 
  30:Source/main.c **** // ─── solve bindings ───────────────────────�
  31:Source/main.c **** 
  32:Source/main.c **** static int lua_solve_reset(lua_State* L) {
  33:Source/main.c ****     (void)L;
  34:Source/main.c ****     solver_reset();
  35:Source/main.c ****     return 0;
  36:Source/main.c **** }
  37:Source/main.c **** 
  38:Source/main.c **** static int lua_solve(lua_State* L) {
  39:Source/main.c ****     (void)L;
  40:Source/main.c ****     size_t chainsLen = 0, loopsLen = 0;
  41:Source/main.c ****     const char* chains = pd->lua->getArgBytes(1, &chainsLen);
  42:Source/main.c ****     const char* loops  = pd->lua->getArgBytes(2, &loopsLen);
  43:Source/main.c **** 
  44:Source/main.c ****     CompState state;
  45:Source/main.c ****     memset(&state, 0, sizeof(state));
  46:Source/main.c **** 
  47:Source/main.c ****     if (chains) {
  48:Source/main.c ****         for (size_t i = 0; i < chainsLen; i++) {
  49:Source/main.c ****             uint8_t len = (uint8_t)chains[i];
  50:Source/main.c ****             if (len > DOTSAI_MAX_LEN) len = DOTSAI_MAX_LEN;
  51:Source/main.c ****             if (len > 0) state.chains[len]++;
  52:Source/main.c ****         }
  53:Source/main.c ****     }
  54:Source/main.c ****     if (loops) {
  55:Source/main.c ****         for (size_t i = 0; i < loopsLen; i++) {
  56:Source/main.c ****             uint8_t len = (uint8_t)loops[i];
  57:Source/main.c ****             if (len > DOTSAI_MAX_LEN) len = DOTSAI_MAX_LEN;
  58:Source/main.c ****             if (len > 0) state.loops[len]++;
  59:Source/main.c ****         }
  60:Source/main.c ****     }
  61:Source/main.c **** 
  62:Source/main.c ****     pd->lua->pushInt(solve(&state));
  63:Source/main.c ****     return 1;
  64:Source/main.c **** }
