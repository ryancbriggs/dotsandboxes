  48:Source/solver.h **** static uint32_t hash_state(const CompState* s) {
  49:Source/solver.h ****     uint32_t h = 2166136261u;                 // FNV-1a
  50:Source/solver.h ****     const uint8_t* p = (const uint8_t*)s;
  51:Source/solver.h ****     for (unsigned i = 0; i < sizeof(*s); i++) { h ^= p[i]; h *= 16777619u; }
  52:Source/solver.h ****     return h;
  53:Source/solver.h **** }
  54:Source/solver.h **** 
  55:Source/solver.h **** static int memo_lookup(const CompState* s, int* out) {
  56:Source/solver.h ****     const uint32_t mask = DOTSAI_MEMO_SIZE - 1;
  57:Source/solver.h ****     const uint32_t base = hash_state(s) & mask;
  58:Source/solver.h ****     for (uint32_t probe = 0; probe < DOTSAI_MEMO_PROBES; probe++) {
  59:Source/solver.h ****         uint32_t idx = (base + probe) & mask;
  60:Source/solver.h ****         if (!s_memo[idx].occupied) return 0;
  61:Source/solver.h ****         if (memcmp(&s_memo[idx].key, s, sizeof(CompState)) == 0) {
  62:Source/solver.h ****             *out = s_memo[idx].value;
  63:Source/solver.h ****             return 1;
  64:Source/solver.h ****         }
  65:Source/solver.h ****     }
  66:Source/solver.h ****     return 0;
  67:Source/solver.h **** }
